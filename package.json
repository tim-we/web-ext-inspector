{
  "name": "extension-inspector",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "start": "vite",
    "postinstall": "node --no-warnings scripts/post-install.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "generate:api": "node scripts/generate-api-list.mjs",
    "check:types": "tsc --noEmit",
    "check:format": "biome format src scripts",
    "format": "biome format src scripts --write",
    "lint": "biome check src scripts",
    "lint:fix": "biome check src scripts --write --diagnostic-level=error",
    "ci": "biome ci src scripts",
    "test": "vitest run --typecheck",
    "test:watch": "vitest watch",
    "test:types": "tsc --noEmit"
  },
  "author": "tim-we",
  "license": "MIT",
  "browserslist": [
    "last 2 Firefox versions, last 2 Chrome versions"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@mdn/browser-compat-data": "7.1.7",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "24.5.2",
    "@types/prismjs": "1.26.5",
    "html-entities": "2.6.0",
    "htmlparser2": "10.0.0",
    "json-stable-stringify": "1.3.0",
    "rimraf": "6.0.1",
    "strip-json-comments": "5.0.3",
    "typescript": "5.9.2",
    "vite": "7.1.6",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@babel/parser": "7.28.4",
    "@babel/traverse": "7.28.4",
    "@preact/signals": "2.3.1",
    "@zip.js/zip.js": "2.8.2",
    "acorn": "8.15.0",
    "acorn-walk": "8.3.3",
    "astring": "1.8.6",
    "comlink": "4.4.2",
    "domhandler": "5.0.3",
    "domutils": "3.1.0",
    "lucide-preact": "0.544.0",
    "postcss": "8.5.5",
    "preact": "10.27.2",
    "pretty-bytes": "7.0.1",
    "prismjs": "1.30.0"
  }
}
