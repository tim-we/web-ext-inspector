{
  "name": "extension-inspector",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "vite",
    "postinstall": "node --no-warnings scripts/post-install.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "generate:api": "node scripts/generate-api-list.mjs",
    "check:types": "tsc --noEmit",
    "check:format": "biome format src scripts",
    "format": "biome format src scripts --write",
    "lint": "biome check src scripts",
    "lint:fix": "biome check src scripts --apply",
    "ci": "biome ci src scripts",
    "test": "vitest run --typecheck",
    "test:watch": "vitest watch",
    "test:types": "tsc --noEmit"
  },
  "author": "tim-we",
  "license": "MIT",
  "browserslist": [
    "last 2 Firefox versions, last 2 Chrome versions"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@mdn/browser-compat-data": "^6.0.22",
    "@types/babel__traverse": "^7.20.7",
    "@types/node": "^24.0.1",
    "@types/prismjs": "^1.26.5",
    "glob": "^11.0.3",
    "html-entities": "^2.6.0",
    "htmlparser2": "^10.0.0",
    "json-stable-stringify": "^1.3.0",
    "rimraf": "^6.0.1",
    "strip-json-comments": "^5.0.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@preact/signals": "^2.0.1",
    "@zip.js/zip.js": "^2.7.47",
    "acorn": "^8.12.1",
    "acorn-walk": "^8.3.3",
    "astring": "^1.8.6",
    "comlink": "^4.4.2",
    "domhandler": "^5.0.3",
    "domutils": "^3.1.0",
    "lucide-preact": "^0.477.0",
    "postcss": "^8.4.40",
    "preact": "^10.26.4",
    "pretty-bytes": "^6.1.1",
    "prismjs": "^1.29.0"
  }
